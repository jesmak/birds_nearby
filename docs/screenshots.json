                                "content": "{% set notable = state_attr('sensor.birds_nearby_notable', 'sightings') %}\n{% set year = state_attr('sensor.birds_nearby_year_list', 'species') %}\n{% set expected = state_attr('sensor.birds_nearby_year_list', 'expected') %}\n### Notable\n{% for s in notable %}**{{ s.name }}**, {{ s.location }}, {{ s.distance_km }} km {{ s.direction }}, {{ s.observed[11:] }}{{ '' if s.reviewed else ' (not yet reviewed)' }}\n{% endfor %}\n### New this year\n{% for s in year[:5] %}{% set days = (as_datetime(s.first_seen) - as_datetime(s.last_year | replace('2025-', '2026-'))).days if s.last_year else none %}**{{ s.name }}** {{ as_datetime(s.first_seen).strftime('%-d %b') }}{% if days is not none %}, {{ days | abs }} {{ 'day' if days | abs == 1 else 'days' }} {{ 'later' if days > 0 else 'earlier' }} than last year{% endif %}\n{% endfor %}\n### Seen by now last year\n{% for s in expected %}{{ s.name }} ({{ as_datetime(s.last_year).strftime('%-d %b') }}){{ ', ' if not loop.last }}{% endfor %}"
